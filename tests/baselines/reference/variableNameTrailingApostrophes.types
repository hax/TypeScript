//// [tests/cases/compiler/variableNameTrailingApostrophes.ts] ////

=== variableNameTrailingApostrophes.ts ===
let x = 1;
>x : number
>  : ^^^^^^
>1 : 1
>  : ^

let x' = x + 2;
>x' : number
>   : ^^^^^^
>x + 2 : number
>      : ^^^^^^
>x : number
>  : ^^^^^^
>2 : 2
>  : ^

const x'' = x' + 1;
>x'' : number
>    : ^^^^^^
>x' + 1 : number
>       : ^^^^^^
>x' : number
>   : ^^^^^^
>1 : 1
>  : ^

var x''' = x'' + 1;
>x''' : number
>     : ^^^^^^
>x'' + 1 : number
>        : ^^^^^^
>x'' : number
>    : ^^^^^^
>1 : 1
>  : ^

using y' = {
>y' : { [Symbol.dispose](): void; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{    [Symbol.dispose]() {},} : { [Symbol.dispose](): void; }
>                             : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    [Symbol.dispose]() {},
>[Symbol.dispose] : () => void
>                 : ^^^^^^^^^^
>Symbol.dispose : unique symbol
>               : ^^^^^^^^^^^^^
>Symbol : SymbolConstructor
>       : ^^^^^^^^^^^^^^^^^
>dispose : unique symbol
>        : ^^^^^^^^^^^^^

};

const o1 = { x' }; // property shorthand strips trailing apostrophes
>o1 : { x: number; }
>   : ^^^^^^^^^^^^^^
>{ x' } : { x: number; }
>       : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x' : number
>   : ^^^^^^

o1.x.toFixed();
>o1.x.toFixed() : string
>               : ^^^^^^
>o1.x.toFixed : (fractionDigits?: number) => string
>             : ^              ^^^      ^^^^^      
>o1.x : number
>     : ^^^^^^
>o1 : { x: number; }
>   : ^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>toFixed : (fractionDigits?: number) => string
>        : ^              ^^^      ^^^^^      

const o2 = { x'': x''' };
>o2 : { x: number; '': number; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>{ x'': x''' } : { x: number; '': number; }
>              : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>'' : number
>   : ^^^^^^
>x''' : number
>     : ^^^^^^

o2.x.toFixed();
>o2.x.toFixed() : string
>               : ^^^^^^
>o2.x.toFixed : (fractionDigits?: number) => string
>             : ^              ^^^      ^^^^^      
>o2.x : number
>     : ^^^^^^
>o2 : { x: number; '': number; }
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>toFixed : (fractionDigits?: number) => string
>        : ^              ^^^      ^^^^^      

{
    let { x' } = o1; // destructuring shorthand strips trailing apostrophes
>x : any
>  : ^^^
>x' : number
>   : ^^^^^^
>o1 : { x: number; }
>   : ^^^^^^^^^^^^^^

    x'.toFixed();
>x'.toFixed() : string
>             : ^^^^^^
>x'.toFixed : (fractionDigits?: number) => string
>           : ^              ^^^      ^^^^^      
>x' : number
>   : ^^^^^^
>toFixed : (fractionDigits?: number) => string
>        : ^              ^^^      ^^^^^      
}

let { x: x'''' } = o1;
>x : any
>  : ^^^
>x'''' : number
>      : ^^^^^^
>o1 : { x: number; }
>   : ^^^^^^^^^^^^^^

x''''.toFixed();
>x''''.toFixed() : string
>                : ^^^^^^
>x''''.toFixed : (fractionDigits?: number) => string
>              : ^              ^^^      ^^^^^      
>x'''' : number
>      : ^^^^^^
>toFixed : (fractionDigits?: number) => string
>        : ^              ^^^      ^^^^^      

class C {
>C : C
>  : ^

    method() {}
>method : () => void
>       : ^^^^^^^^^^

    method'() {} // should error
>method : () => void
>       : ^^^^^^^^^^
>'() {} // should error : any
>                       : ^^^
}

const obj = {
>obj : { method: any; '() {}, // should error': any; }
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>{    method'() {}, // should error} : { method: any; '() {}, // should error': any; }
>                                    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

    method'() {}, // should error
>method : any
>       : ^^^
>'() {}, // should error : any
>                        : ^^^

};
> : any
> : ^^^

